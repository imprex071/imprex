rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Allow read/write for all collections for authenticated users
    // In a production app, you should restrict this further.
    match /{document=**} {
      allow read, write: if true; // Permissivo para desenvolvimento, ajuste conforme necessário
    }

    // Specific rules for config/checkout
    match /config/checkout {
      allow read: if true;
      allow write: if true;
    }

    // Rules for banners
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    // Rules for products
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Rules for settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
